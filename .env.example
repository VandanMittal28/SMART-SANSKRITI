# Supabase browser client configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only NVIDIA NIM credentials. Never prefix the API key with NEXT_PUBLIC_.
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_SPEECH_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Chatterbox narration API proxy.
CHATTERBOX_BASE_URL=https://your-chatterbox-service.example.com
CHATTERBOX_DEMO_TOKEN=your-chatterbox-demo-token
CHATTERBOX_ALLOWED_ORIGINS=http://localhost:3000
NVIDIA_CHATTERBOX_SERVER=https://your-nvidia-chatterbox-server.example.com
NVIDIA_CHATTERBOX_FUNCTION_ID=your-nvidia-function-id
