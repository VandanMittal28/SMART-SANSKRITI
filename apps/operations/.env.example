# The MMS console signs staff in with Supabase Auth and reads site-scoped
# tables through Row Level Security. Without these two the console cannot
# build its client and the page fails with "MMS database configuration is
# missing." Both are public values (the anon key is safe in a browser); RLS,
# not secrecy, is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Lets the console run its own triage on incoming reports.
# Never prefix with NEXT_PUBLIC_.
NVIDIA_API_KEY=
NVIDIA_VISION_MODEL=
