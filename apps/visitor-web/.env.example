# Server-side NVIDIA key, reused from the mobile app. Never make this public.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_SPEECH_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Existing Sanskriti MMS database. Only the public anon key is used;
# anonymous sign-in and the MMS visitor-report migration must be enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
REPORTS_MODE=supabase

# Optional local demo alternative (never used by Vercel):
# REPORTS_MODE=local-demo
# OPS_BASE_URL=http://127.0.0.1:3100
