# Sanskriti visitor website: copy to .env.local and fill in what you need.
# Every value is SERVER-ONLY. Never prefix them with NEXT_PUBLIC_.

# NVIDIA NIM: powers monument recognition, Yatrik's live answers and voice
# transcription. Leave empty and the website shows honest "not switched on
# yet" states instead (Yatrik then answers from saved monument notes).
# Each request is billed to this key.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_SPEECH_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Local operations demo (apps/operations). Visitor reports are forwarded here
# by this website's server. Must be a loopback address: the operations report
# API is a local sandbox and is not a public service.
OPS_BASE_URL=http://127.0.0.1:3100
