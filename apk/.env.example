# The default standalone build loads UI bundled inside the APK.
SANSKRITI_APP_URL=https://appassets.androidplatform.net/

# Server-only NVIDIA NIM credentials. Never prefix the API key with NEXT_PUBLIC_.
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_SPEECH_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Chatterbox narration API proxy. It calls NVIDIA's hosted service and does
# not load the downloaded Chatterbox model weights on this machine.
CHATTERBOX_BASE_URL=http://127.0.0.1:8000
CHATTERBOX_DEMO_TOKEN=
CHATTERBOX_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NVIDIA_CHATTERBOX_SERVER=grpc.nvcf.nvidia.com:443
NVIDIA_CHATTERBOX_FUNCTION_ID=ddacc747-1269-4fab-bfd9-8f593dead106
